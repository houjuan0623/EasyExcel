{
  "name": "easyexcel-desktop",
  "productName": "EasyExcel",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "EasyExcel offline spreadsheet and Python workbench.",
  "author": "AbeLin",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "build:backend": "node scripts/build-backend.cjs",
    "pack:win": "npm run build && npm run build:backend && node scripts/package-win.cjs --dir",
    "dist:win": "npm run build && npm run build:backend && node scripts/package-win.cjs",
    "dist:portable": "npm run build && npm run build:backend && node scripts/package-win.cjs --zip",
    "start": "electron .",
    "test:smoke": "node scripts/smoke.cjs",
    "test:packaged": "node scripts/smoke.cjs --packaged",
    "test:library": "tsc -p tsconfig.electron.json && node --test scripts/script-library.test.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.58.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
